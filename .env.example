# =====================================================================
# Postgres (the existing pgvector-enabled DB that ingest.py writes to)
# =====================================================================
PG_HOST=KYC164283DEV.pgaas.dyn.nsroot.net
PG_PORT=1524
PG_USER=
PG_PASSWORD=
PG_DATABASE=chunker_db
PG_SCHEMA=vector_ng12499
PG_TABLE=chunk_embeddings
APP_OWNER_ROLE=citi_pg_app_owner

# =====================================================================
# LLM provider:
#   vertex_internal -> production: Vertex via internal proxy (COIN-token,
#                      via get_llm.VertexGenAI). RECOMMENDED.
#   vertex          -> local dev: Vertex with a Google service-account JSON
#                      (talks directly to Google).
#   stellar         -> legacy: OpenAI-compatible Stellar (Llama/Mistral).
LLM_PROVIDER=vertex_internal

# ---------------------------------------------------------------------
# Vertex AI (local-only path; ignored when LLM_PROVIDER=stellar)
# ---------------------------------------------------------------------
# Path to a Google service-account JSON. project_id is read from the file.
GOOGLE_APPLICATION_CREDENTIALS=/Users/neelu/dev/nlp2sql-491115-200db3f6447d.json
VERTEX_PROJECT=nlp2sql-491115
VERTEX_LOCATION=us-central1
VERTEX_BASE_URL=https://r2d2-c3p0-icg-msst-genaihub-178909.apps.namicg39023u.ecs.dyn.nsroot.net/vertex
VERTEX_DEFAULT_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_FINAL_GEN_MODEL=gemini-2.5-flash
VERTEX_RERANK_MODEL=gemini-2.5-flash
VERTEX_FAST_MODEL=gemini-2.5-flash
VERTEX_CONTEXTUAL_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Internal-Vertex models (used when LLM_PROVIDER=vertex_internal).
# Default everything to gemini-2.0-flash-001 - small, fast, supports
# structured outputs. Override individual roles in .env if you want a
# heavier model for the final answer (e.g. gemini-2.5-pro).
# ---------------------------------------------------------------------
INTERNAL_VERTEX_EMBEDDING_MODEL=text-embedding-005
INTERNAL_VERTEX_FINAL_GEN_MODEL=gemini-2.0-flash-001
INTERNAL_VERTEX_RERANK_MODEL=gemini-2.0-flash-001
INTERNAL_VERTEX_FAST_MODEL=gemini-2.0-flash-001
INTERNAL_VERTEX_CONTEXTUAL_MODEL=gemini-2.0-flash-001

# =====================================================================
# Stellar / COIN OAuth (consumed by get_llm.py — re-used here)
# =====================================================================
COIN_URL=
COIN_CLIENT_ID=
COIN_CLIENT_SECRET=
COIN_SCOPE=
SSL_CERT_FILE=

# Embedding model — MUST match what ingest.py used (gte-large-en-v1.5)
STELLAR_EMBEDDING_MODEL=gte-large-en-v1.5

# Stellar base URL (where the OpenAI-compatible Stellar API lives) and
# chat-model defaults consumed by get_llm.py:
STELLAR_BASE_URL=https://r2d2-c3p0-icg-msst-genaihub-178909.apps.namicg39023u.ecs.dyn.nsroot.net/citi-genai/stellar/v1
STELLAR_CHAT_MODEL=Llama-4-Scout-17B-16E-Instruct
STELLAR_MAX_TOKENS=4096

# Generation / reasoning model defaults per task. All Stellar-hosted.
STELLAR_FINAL_GEN_MODEL=Llama-4-Scout-17B-16E-Instruct
STELLAR_RERANK_MODEL=Meta-Llama-3.3-70B-Instruct
STELLAR_FAST_MODEL=Meta-Llama-3.1-8B-Instruct
STELLAR_CONTEXTUAL_MODEL=Llama-4-Scout-17B-16E-Instruct

# =====================================================================
# Retrieval pipeline defaults (tunable at runtime from UI)
# =====================================================================
RAG_TOPK_DENSE=50
RAG_TOPK_SPARSE=50
RAG_RRF_K=60
RAG_RERANK_TOPN=20
RAG_FINAL_K=8
RAG_MMR_LAMBDA=0.7

# Toggles (defaults; UI can override per-query)
RAG_HYDE_DEFAULT=true
RAG_REWRITE_DEFAULT=false
RAG_RERANK_DEFAULT=true
RAG_CRAG_DEFAULT=false
RAG_CONTEXTUAL_DEFAULT=true

# =====================================================================
# Remote ingestion service (optional)
# =====================================================================
# When true, POST /api/ingest/wega proxies the upload to the standalone
# `ingest_remote/` FastAPI service instead of running ingestion in-process.
# Retrieval, chat, documents, analytics, view/download all keep working
# when the remote is down — only new ingestion fails (fast, with a clear
# error event in the SSE stream).
REMOTE_INGEST=false
REMOTE_INGEST_URL=http://localhost:8090
# Optional shared secret — the backend sends it in X-Ingest-Secret; the
# remote service rejects calls that don't match. Leave empty to disable.
REMOTE_INGEST_SECRET=
# Long timeout because ingesting large PDFs can take minutes.
REMOTE_INGEST_TIMEOUT=1800

# =====================================================================
# S3 / MinIO — source PDFs are persisted here for View + Download
# =====================================================================
# Set S3_ENABLED=false to skip uploading source PDFs. Retrieval still
# works without it, but the "View" / "Download" buttons in the UI will
# return 404 because no s3_uri is stored.
S3_ENABLED=true
# Leave S3_ENDPOINT_URL empty to use real AWS. The default points at a
# local MinIO instance bound to 127.0.0.1:9000 (started by entrypoint.sh).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rag-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# =====================================================================
# Server
# =====================================================================
APP_HOST=0.0.0.0
APP_PORT=8080
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_LOG_LEVEL=INFO

# =====================================================================
# Auth refresh (COIN access tokens)
# =====================================================================
# Refresh the cached LLM client every N seconds so the underlying COIN
# token is always fresh. Default is 14 min; COIN tokens typically last
# 60 min so this leaves plenty of headroom.
COIN_TOKEN_TTL_SECONDS=840
