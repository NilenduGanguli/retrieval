# =====================================================================
# Remote ingestion service — env-driven settings
# =====================================================================
# Every field on `RemoteIngestSettings` (ingest_remote/app/config.py) has
# a corresponding entry below. Copy this file to .env, fill in real values
# (paths, secrets) and adjust the provider.

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Auth: shared secret the calling backend must send in X-Ingest-Secret.
# Leave empty during dev to disable the check.
# ---------------------------------------------------------------------
SHARED_SECRET=

# =====================================================================
# Provider — "wega" (production) | "vertex" (local laptop test)
# =====================================================================
#   wega   → internal WegaChunker + Stellar embeddings (needs the wheel
#            + a copy of get_llm.py)
#   vertex → pypdf chunker + Google Vertex embeddings (works on a laptop
#            with a service-account JSON)
LLM_PROVIDER=wega

# ---------------------------------------------------------------------
# Vertex AI — used only when LLM_PROVIDER=vertex
# ---------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/Users/neelu/dev/nlp2sql-491115-200db3f6447d.json
VERTEX_PROJECT=nlp2sql-491115
VERTEX_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005

# Local pypdf char-chunker tuning (applied only in vertex mode).
LOCAL_CHUNK_MAX_CHARS=1500
LOCAL_CHUNK_OVERLAP=150

# ---------------------------------------------------------------------
# WEGA chunker — used only when LLM_PROVIDER=wega
# ---------------------------------------------------------------------
AZURE_DI_ENDPOINT=http://sd-jibs-35nc.nam.nsroot.net:5000
AZURE_DI_KEY=
CHUNK_TOKEN_SIZE=500
DOCUMENT_TYPE=General
DETECT_PII=true
EXTRACT_IMAGES=false

# =====================================================================
# Postgres / pgvector — destination table for the chunks
# =====================================================================
PG_HOST=KYC164283DEV.pgaas.dyn.nsroot.net
PG_PORT=1524
PG_USER=kyc164283devpgaas
PG_PASSWORD=
PG_DATABASE=chunker_db
PG_SCHEMA=vector_ng12499
PG_INDEX=chunk_embeddings
# Postgres role that owns the target schema. Used during startup
# bootstrap (SET ROLE + CREATE SCHEMA / TABLEs if missing). Leave empty
# if the connecting user is already the owner.
PG_APP_OWNER_ROLE=citi_pg_app_owner

# =====================================================================
# Embedding batching
# =====================================================================
EMBEDDING_BATCH_SIZE=16

# =====================================================================
# S3 / MinIO — source-PDF persistence (independent of main backend)
# =====================================================================
# Enable when the remote service is deployed STANDALONE (no main backend
# in front uploading PDFs). When the main backend's REMOTE_INGEST is on,
# the backend already uploads — keep S3_ENABLED=false here to avoid
# double-uploading.
S3_ENABLED=false
# Leave S3_ENDPOINT_URL empty to use real AWS.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=rag-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# =====================================================================
# Working directory for uploaded PDFs (deleted after each job).
# =====================================================================
UPLOAD_DIR=/tmp/remote_ingest_uploads

# =====================================================================
# Stellar / COIN OAuth - consumed by get_llm.py (lives inside this dir)
# =====================================================================
# Required when LLM_PROVIDER=wega (Stellar embeddings).
#
# SSL_CERT_FILE: path to the internal Citi CA bundle (PEM). The TLS
# cert that Stellar presents is signed by the Citi internal root CA;
# httpx/openai don't trust it unless this file is supplied.
SSL_CERT_FILE=/app/cert.pem

# COIN OAuth2 endpoint + base64-encoded client credentials
COIN_URL=https://uat.secureaccess.coin.nam.citigroup.net/as/token.oauth2
COIN_CLIENT_ID=
COIN_CLIENT_SECRET=
COIN_SCOPE=

# Refresh the cached OpenAI/httpx client every N seconds so the COIN
# token never expires mid-request. Default 14 min; COIN tokens last
# ~60 min so this leaves headroom.
COIN_TOKEN_TTL_SECONDS=840
# Stellar API endpoint + chat-model defaults (required by get_llm.py at
# import time even when LLM_PROVIDER=vertex — module-level _require checks).
STELLAR_BASE_URL=https://r2d2-c3p0-icg-msst-genaihub-178909.apps.namicg39023u.ecs.dyn.nsroot.net/citi-genai/stellar/v1
STELLAR_CHAT_MODEL=Llama-4-Scout-17B-16E-Instruct
STELLAR_MAX_TOKENS=4096

# Vertex-via-Stellar-proxy URL + default model (required at get_llm.py
# import time; harmless when actually using LLM_PROVIDER=vertex with the
# real Google Vertex SDK).
VERTEX_BASE_URL=https://r2d2-c3p0-icg-msst-genaihub-178909.apps.namicg39023u.ecs.dyn.nsroot.net/vertex
VERTEX_DEFAULT_MODEL=gemini-2.5-flash
